# ============================================================================
# forge — the switchboard
# ----------------------------------------------------------------------------
# Copy to .env and edit. Every capability is a slot with a self-hosted default
# and paid alternatives. The defaults below run the whole pipeline on one box
# with no third-party account except stock footage, which is free.
#
# Swapping a slot is a line here plus a restart. Nothing in the code changes.
# `python -m forge.cli doctor` prints which slots are local and which are not.
# ============================================================================

TIMEZONE=Asia/Amman

# --- secrets you must set ---------------------------------------------------
POSTGRES_USER=forge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forge

# n8n refuses to start without this, and regenerating it invalidates every
# stored credential. Generate once: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

S3_ACCESS_KEY=forge
S3_SECRET_KEY=change-me-too

# Leave empty to serve plain HTTP on :80. Set a real hostname and Caddy
# provisions TLS by itself.
FORGE_DOMAIN=

# ============================================================================
# WRITING
# ----------------------------------------------------------------------------
# Two slots on purpose. LLM handles the mechanical volume — scoring, tagging,
# dedupe, metadata — which is most of the calls and none of the quality the
# audience notices. LLM_SCRIPT writes what they actually hear.
#
# Self-hosting the scripting model is the one place where self-hosting costs
# MORE than the API: a model good enough for it needs 48GB+ of VRAM, which is
# $300-800/month of GPU against maybe $20/month of API for ~15 calls a day.
# Run the small model locally, buy the scripting. That split is the default.
# ============================================================================

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=http://ollama:11434/v1

# Falls back to LLM_PROVIDER when unset. Set it once you have compared output.
# LLM_SCRIPT_PROVIDER=anthropic
# LLM_SCRIPT_MODEL=claude-sonnet-5
# LLM_SCRIPT_API_KEY=

# Anything else serving /chat/completions — vLLM, LM Studio, Groq, OpenRouter,
# LocalAI — is the same client with a different base URL.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://your-host:8000/v1
# LLM_API_KEY=
# LLM_MODEL=

# ============================================================================
# NARRATION
# ----------------------------------------------------------------------------
# kokoro (default) | piper | openai | elevenlabs
#
# Kokoro runs on CPU and serves an OpenAI-shaped endpoint, so the local and
# paid paths are the same client code. This was the largest recurring cost in
# a pipeline like this and it is now a container.
# ============================================================================

TTS_PROVIDER=kokoro
TTS_BASE_URL=http://kokoro:8880/v1
DEFAULT_VOICE=af_heart
TTS_FORMAT=mp3

# TTS_PROVIDER=elevenlabs
# TTS_API_KEY=
# DEFAULT_VOICE=<elevenlabs voice id>

# ============================================================================
# VISUALS
# ----------------------------------------------------------------------------
# pexels (default) | library | comfyui | openai
#
# Most faceless content is stock B-roll with motion and text over it, not
# generated imagery. Pull from Pexels, keep what works in /data/media/library,
# then switch to `library` and the slot depends on nobody.
#
# comfyui wants a GPU. Run it as a batch job on a rented instance that spins
# up, drains the queue and dies — twenty minutes a day, not always-on.
# ============================================================================

IMAGE_PROVIDER=pexels
IMAGE_API_KEY=

# IMAGE_PROVIDER=library

# ============================================================================
# CAPTIONS
# ----------------------------------------------------------------------------
# whisper_asr (default) | openai | none
# Most of your audience watches muted. This is not an accessibility extra.
# ============================================================================

TRANSCRIBE_PROVIDER=whisper_asr
WHISPER_URL=http://whisper:9000
WHISPER_MODEL=base

# ============================================================================
# RENDERING
# ----------------------------------------------------------------------------
# ffmpeg (default) | remote
#
# ffmpeg is free and fast enough: a dozen cuts a day is minutes of CPU. Switch
# to `remote` to push rendering onto another box running the same worker when
# encoding starts competing with everything else for cores.
# ============================================================================

RENDER_PROVIDER=ffmpeg
# RENDER_BASE_URL=
# RENDER_API_KEY=
MUSIC_GAIN_DB=-22

# ============================================================================
# STORAGE
# ----------------------------------------------------------------------------
# minio (default) | local | any S3-compatible endpoint
#
# S3_PUBLIC_BASE only matters for publishers that fetch media by URL rather
# than accepting an upload — it must be reachable from outside this network.
# ============================================================================

STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_BUCKET=forge
S3_REGION=us-east-1
S3_PUBLIC_BASE=
MEDIA_ROOT=/data/media

# ============================================================================
# PUBLISHING
# ----------------------------------------------------------------------------
# dry_run (default) | postiz | mixpost | ayrshare | blotato
#
# Leave this on dry_run until the pipeline is proven end to end. It records the
# exact payload it would have sent and posts nothing.
#
# Read this before choosing: every option here still requires your own
# developer app on each platform and survival of its review. Postiz removes the
# scheduling and token-refresh work, not the approval work. TikTok in
# particular only allows private/draft posts until your app is audited.
# ============================================================================

PUBLISH_PROVIDER=dry_run
PLATFORMS=youtube,tiktok,instagram

# PUBLISH_PROVIDER=postiz
# POSTIZ_URL=http://postiz:5000/api/public/v1
# PUBLISH_API_KEY=
# POSTIZ_JWT_SECRET=

# PUBLISH_PROVIDER=ayrshare
# PUBLISH_API_KEY=

# ============================================================================
# URLs for the browser-facing services
# ============================================================================

N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
NOCODB_PUBLIC_URL=http://localhost:8080
